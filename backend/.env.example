# Hammasi ixtiyoriy. Maxfiy kalit kerak emas: parollar bazada scrypt bilan xeshlanadi.
PORT=8787
PUBLIC_URL=http://localhost:8787
DB_PATH=./data/pulim.db
# https orqali ishlatilganda 1 qiling (cookie faqat https da yuboriladi)
COOKIE_SECURE=0
# Frontend build papkasi (standart: ../frontend/dist)
# STATIC_DIR=../frontend/dist

# Google va GitHub orqali kirish (ixtiyoriy, OAuth 2.0).
# Callback manzillarini quyidagicha ko'rsating:
#   Google: http://localhost:8787/api/auth/google/callback
#   GitHub: http://localhost:8787/api/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Telegram bot (ixtiyoriy). Tokenni @BotFather dan oling. Bot server bilan birga ishga tushadi.
# BOT_TOKEN=123456:ABC...
# BOT_USERNAME=mizan_uz_bot

# Mizan AI (Gemini API kaliti). Google AI Studio'dan oling.
# GEMINI_API_KEY=

# Standart: faqat shu kompyuter (127.0.0.1). Tarmoqqa ochish uchun 0.0.0.0 (https va ishonchli tarmoqda!)
# HOST=127.0.0.1

# Administrator foydalanuvchilar (vergul bilan ajratilgan username ro'yxati).
# Yoki CLI orqali: npm run admin -- foydalanuvchi_nomi
# ADMIN_USERNAMES=admin

# Demo kirish standart holatda o'chirilgan; faqat test uchun 1 qilinadi
# ENABLE_DEMO_AUTH=0
